---
// A board at any level: the ranked chart (most biased first), the engines with no bias detected
// (listed with n, never ranked), and the engines never measured here (named, never zero).
import Chart from "./Chart.astro";
import EngineName from "./EngineName.astro";
import { engineById, fmt, int, signed } from "../lib/site.js";
import { kindNames, unitText } from "../scripts/util.js";

const { board, heads, unit, facetKind, chartId, hrefFor, heading = "The ranking: most biased model first", level = "h2", lede = null,
  shows = "Each result shows how far one edit moved a model's answers, beyond a harmless edit of the same size. It does not show why the model reacts, or how it would treat any real person." } = Astro.props;
const H = level;
const ranked = board.ranked;
const u = unitText(unit);
---
<section class="wrap section board-sec">
  <H class={level === "h2" ? "display" : "display sm"}>{heading}</H>
  {ranked.length > 0
    ? <Fragment>
        <p class="lede">{lede || `Most biased first. Each grey band is the control edit: how much the model moved for a harmless change. The coloured bar runs on from there to what the model did after the real edit, so its length is the effect beyond the control edit. The whisker is the range we are 95% sure of${facetKind ? `, and the thin ticks are the model's other ${kindNames(facetKind)}` : ""}. Select a row for that model's details.`}</p>
        <Chart id={chartId} />
        {shows && <p class="note board-shows">{shows}</p>}
        <ol class="board-list sr">
          {ranked.map((r) => <li>{engineById[r.engine].label}: {fmt(r.value)} percentage points beyond the control edit, range {fmt(r.lo)} to {fmt(r.hi)}, on {r.facet_label}{r.direction ? `; it became ${r.direction.phrase}` : ""}</li>)}
        </ol>
      </Fragment>
    : <Fragment>
        <p class="lede strong">No model moved clearly more than it does for the control edit here, so nothing is ranked.</p>
        {shows && <p class="note board-shows">{shows}</p>}
      </Fragment>}
  {board.not_detected.length > 0 && (
    <div class="nd-list">
      <h3>No clear effect, so not ranked</h3>
      <ul>
        {board.not_detected.map((r) => {
          const hd = heads[r.engine].headline;
          return (
            <li>
              <EngineName engine={engineById[r.engine]} href={hrefFor(r.engine)} />
              <span class="nd-n">{int(r.n)} texts tested{r.n_facets > 1 ? ` (the largest of ${r.n_facets} ${kindNames(facetKind)})` : ""}.</span>
              <span class="nd-v">After the edit {fmt(hd.raw.value)}{u} [{fmt(hd.raw.lo)}, {fmt(hd.raw.hi)}], control edit {fmt(hd.floor_value)}{u}; beyond the control edit {signed(r.value)} percentage points [{fmt(r.lo)}, {fmt(r.hi)}]{r.direction ? `; it became ${r.direction.phrase}` : ""}.</span>
            </li>
          );
        })}
      </ul>
      <p class="note">Where the range includes zero, we could not tell the result from chance with this many texts. That does not mean the model is fair. Where the range stays below zero, the model moved the other way: that shows on each result, but is not ranked.</p>
    </div>
  )}
  {board.unmeasured.length > 0 && (
    <p class="unmeasured"><span class="hatch"></span><span>Not tested here: {board.unmeasured.map((id, i) => <Fragment>{i ? ", " : ""}<a href={hrefFor(id)}>{engineById[id].label}</a></Fragment>)}. Shown as missing, never as zero.</span></p>
  )}
</section>
