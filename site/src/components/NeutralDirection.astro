---
// Which way the bias runs: for each task, the neutral wordings placed between the "she" verdict
// (left) and the "he" verdict (right). Position 0 is the verdict for "she", 1 the verdict for "he".
import MarkShape from "./MarkShape.astro";
import { data, engineById, signed, fmt } from "../lib/site.js";

const { engineId = "laya", tasks = null } = Astro.props;
const engine = engineById[engineId];
let rows = data.neutral.rows.filter((r) => r.engine === engineId && (!tasks || tasks.includes(r.task)));
rows = [...rows].sort((a, b) => Math.abs(b.gap_pts.mean) - Math.abs(a.gap_pts.mean));
if (!rows.length) rows = [];
const LO = -0.3, HI = 1.35, X0 = 250, X1 = 700, RH = 58, TOP = 34;
const W = 760, H = TOP + rows.length * RH + 40;
const x = (v) => X0 + ((Math.min(HI, Math.max(LO, v)) - LO) / (HI - LO)) * (X1 - X0);
const lean = (l) => (l < 0.3 ? "near the answer for “she”" : l > 0.7 ? "near the answer for “he”" : "between the two");
const verdict = (r) => {
  if (!r.reportable) return "gap under 2 points, too small to show a direction";
  const b = r.position.blank;
  return `the neutral version sits ${lean(b.lambda)} (${fmt(b.lambda)})`;
};
const summary = rows.map((r) => `${r.task_label}: he minus she ${signed(r.gap_pts.mean)} percentage points; ${verdict(r)}.`).join(" ");
---
{rows.length > 0 && (
  <figure class="nchart">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Where the model's answer for the neutral version sits between its answers for she and for he. ${summary}`} class="nchart-svg">
      {[0, 0.5, 1].map((t) => <line x1={x(t)} x2={x(t)} y1={TOP - 8} y2={H - 34} class={t === 0.5 ? "nc-mid" : "nc-axis"} />)}
      <text x={x(0)} y={TOP - 14} text-anchor="middle" class="nc-t">answer for “she”</text>
      <text x={x(1)} y={TOP - 14} text-anchor="middle" class="nc-t">answer for “he”</text>
      {rows.map((r, i) => {
        const y = TOP + i * RH + RH / 2;
        const b = r.position.blank, t = r.position.they;
        return (
          <g>
            <text x="8" y={y - 4} class="nc-task">{r.task_label}</text>
            <text x="8" y={y + 13} class="nc-sub">{signed(r.gap_pts.mean)} points, he minus she</text>
            <line x1={x(0)} x2={x(1)} y1={y} y2={y} class="nc-span" />
            <circle cx={x(0)} cy={y} r="6" class="nc-she" />
            <circle cx={x(1)} cy={y} r="6" class="nc-he" />
            {r.reportable && b && (
              <g>
                <line x1={x(b.ci[0])} x2={x(b.ci[1])} y1={y} y2={y} stroke={`var(--eng-${engineId})`} stroke-width="3" />
                <MarkShape engine={engine} cx={x(b.lambda)} cy={y} r={7.5} />
                {t && <MarkShape engine={engine} cx={x(t.lambda)} cy={y + 15} r={5} hollow />}
              </g>
            )}
            {!r.reportable && <text x={x(0.5)} y={y + 4} text-anchor="middle" class="nc-sub">gap too small to place the neutral version</text>}
          </g>
        );
      })}
      <text x={x(0)} y={H - 10} text-anchor="middle" class="nc-sub">○ she</text>
      <text x={x(1)} y={H - 10} text-anchor="middle" class="nc-sub">● he</text>
    </svg>
    <figcaption class="nc-cap">
      <span class="nc-key"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><MarkShape engine={engine} cx={8} cy={8} r={6} /></svg> neutral wording, “the person” (line: the range we are 95% sure of)</span>
      <span class="nc-key"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><MarkShape engine={engine} cx={8} cy={8} r={5} hollow /></svg> neutral wording, “they” (a check on the first)</span>
      Each row is one decision, on its own scale. The left end is the model's answer when the biography says “she”; the right end, when it says “he”. The answer is the model's confidence, its own probability for the job. A mark near the left means that with no pronoun the answer stays where “she” put it, so “he” is the word that moves it. A mark near the right means “she” is the word that moves it. Largest gap first.
    </figcaption>
    <table class="sr">
      <caption>Where the answers for the neutral versions sit between the answers for she and for he, by decision</caption>
      <thead><tr><th>decision</th><th>he minus she (percentage points)</th><th>&ldquo;the person&rdquo; position [95% range]</th><th>&ldquo;they&rdquo; position [95% range]</th></tr></thead>
      <tbody>{rows.map((r) => <tr><th>{r.task_label}</th><td>{signed(r.gap_pts.mean)}</td>
        <td>{r.position.blank ? `${fmt(r.position.blank.lambda)} [${fmt(r.position.blank.ci[0])}, ${fmt(r.position.blank.ci[1])}]` : "gap too small"}</td>
        <td>{r.position.they ? `${fmt(r.position.they.lambda)} [${fmt(r.position.they.ci[0])}, ${fmt(r.position.they.ci[1])}]` : "gap too small"}</td></tr>)}</tbody>
    </table>
  </figure>
)}
