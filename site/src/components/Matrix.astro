---
// A two-axis dimension at a glance: groups down, items across. Each cell shows the most biased
// engine's excess there (or, with `engineId`, that engine's own), shaded by size, and links to
// the cell's page.
import Marker from "./Marker.astro";
import { engineById, fmt, signed, urls, matrixCell, cap } from "../lib/site.js";
import { kindName, VERDICT_WORDS } from "../scripts/util.js";

const { dim, engineId = null, caption } = Astro.props;
const bd = dim.breakdown;
const grid = bd.groups.map((g) => ({ g, cells: bd.items.map((i) => matrixCell(dim, bd.cells.find((c) => c.group === g.id && c.item === i.id), engineId)) }));
let max = 0;
for (const r of grid) for (const c of r.cells) if (c.status === "measured" && (c.detected || c.reverse)) max = Math.max(max, Math.abs(c.value));
---
<div class="table-scroll matrix-scroll" tabindex="0" role="region" aria-label={caption}>
  <table class="matrix">
    <caption class="sr">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="mx-corner"><span>{kindName(bd.group_kind)}</span> <span class="muted">/ {kindName(bd.item_kind)}</span></th>
        {bd.items.map((i) => <th scope="col"><a href={urls.at(dim, null, i.id)}>{i.label}</a></th>)}
      </tr>
    </thead>
    <tbody>
      {grid.map(({ g, cells }) => (
        <tr>
          <th scope="row"><a href={urls.at(dim, g.id, null)}>{g.label}</a></th>
          {cells.map((c, k) => {
            const item = bd.items[k];
            const label = `${g.label}, ${item.label}`;
            const live = Object.values(bd.cells.find((x) => x.group === g.id && x.item === item.id).engines).some((f) => f.status === "measured");
            if (c.status !== "measured") return live
              ? <td class="mx miss"><a href={c.href} aria-label={`${label}: not tested`}><span class="mx-v">—</span></a></td>
              : <td class="mx miss"><span class="mx-v" aria-label={`${label}: not tested`}>—</span></td>;
            const sig = c.detected || c.reverse;
            const v = sig && max > 0 ? Math.max(0.12, Math.abs(c.value) / max) : 0;
            const cls = `mx${c.detected ? " det" : c.reverse ? " rev" : c.attributable === false ? " unat" : " nd"}`;
            const style = sig ? `--v:${v.toFixed(3)};--c:var(--alarm)` : null;
            const word = c.detected ? VERDICT_WORDS.det : c.reverse ? VERDICT_WORDS.rev : c.attributable === false ? VERDICT_WORDS.un : VERDICT_WORDS.nd;
            return (
              <td class={cls} style={style}>
                <a href={c.href} aria-label={`${label}: ${engineById[c.engine].label}, ${signed(c.value)} percentage points beyond the control edit, ${word}`}>
                  <span class="mx-v">{signed(c.value)}</span>
                  {!engineId && sig && <span class="mx-e"><Marker engine={engineById[c.engine]} size={9} />{engineById[c.engine].label}</span>}
                  {!sig && <span class="mx-e">{word}</span>}
                </a>
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="note mx-key"><span class="mx-sw det"></span> a clear effect <span class="mx-sw rev"></span> a clear effect in the opposite direction, away from the stereotype (striped) <span class="mx-sw unat"></span> every group moved alike, so we cannot blame one group <span class="mx-sw nd"></span> no clear effect <span class="mx-sw miss"></span> not tested. A darker shade is a larger effect, in either direction. Each number is {engineId ? `${engineById[engineId].label}'s` : "the most biased model's"} result beyond the control edit, in percentage points{engineId ? "" : ". Select a square to see every model"}.</p>
