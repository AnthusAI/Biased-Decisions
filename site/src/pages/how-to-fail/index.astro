---
// Munger's inversion applied to fast decision models: identify the choices that could cause a
// bad outcome, then avoid them. Compact cards retain stable anchors for risk-panel deep links.
import Base from "../../layouts/Base.astro";
import { urls } from "../../lib/site.js";
import { C, curls, REPO_BLOB, evidence } from "../../lib/compliance.js";

const inv = C.inversion;
const lead = evidence("shortlist-laya-attorney-500");
const description = "Charlie Munger's inversion for fast decision models: they can be useful, so ask what deployment choices would make them fail—and avoid those choices. Not legal advice.";
---
<Base title="How to cause a compliance failure" description={description} path={curls.howToFail()} current={{ page: "how-to-fail" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "How to fail" }]}>
  <section class="wrap hero inv-hero">
    <p class="kicker risk-kicker"><svg class="reg-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M10 1.6 19.2 18H.8Z" fill="currentColor"/><path d="M9 7h2v5.4H9zM9 13.8h2V16H9z" class="reg-glyph"/></svg>Inversion · regulated decisions</p>
    <h1 class="display xl">How to cause a compliance failure with a fast decision model</h1>
    <figure class="inv-quote">
      <blockquote><p>“{inv.quote}”</p></blockquote>
      <figcaption>{inv.attribution}. <a href={inv.source_url}>Transcript</a>.</figcaption>
    </figure>
    <p class="deck">Decision models can be genuinely useful. Inversion asks the more useful second question: <strong>what choices would make this deployment fail?</strong> The cards below name those choices and the safer alternative.</p>
    <p class="finding inv-finding"><span class="finding-num">{lead.ratio}</span><span class="finding-txt"><a href={lead.href}>Laya's measured shortlist fell below the {C.shortlist.line.toFixed(2)} four-fifths line.</a> That is why the deployment choices matter.</span></p>
    <div class="footnote risk-notice" role="note"><p>{C.notice}</p></div>
  </section>

  <section class="wrap section" aria-labelledby="recipes-h">
    <h2 class="display sm" id="recipes-h">The failure modes</h2>
    <p class="lede">These are not instructions. They are a pre-mortem: if a deployment harmed people or broke a rule, which shortcut would have caused it?</p>
    <div class="compact-cards">
      {C.recipes.map((r, i) => (
        <article class="recipe compact-card" id={r.id} aria-labelledby={`${r.id}-h`}>
          <p class="recipe-n">{String(i + 1).padStart(2, "0")}</p>
          <h3 id={`${r.id}-h`}>{r.title} <a class="anchor" href={`#${r.id}`} aria-label={`Link to ${r.title}`}>#</a></h3>
          <p><strong>Instead:</strong> {r.inverse}</p>
          <p class="card-links"><a href={curls.guidance(r.insight)}>What to do</a><span aria-hidden="true"> · </span>{r.evidence.map((id, k) => <Fragment>{k ? ", " : ""}<a class="ev-link" href={evidence(id).href}>evidence {k + 1}</a></Fragment>)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" id="not-yet-measured" aria-labelledby="nym-h">
    <h2 class="display sm" id="nym-h">Pre-registered, not yet measured</h2>
    <p class="lede">We do not claim a result where no engine has been measured. <a href={`${REPO_BLOB}${C.unmeasured[0].repo_ref.path}`}>See the pre-registered decisions and governing rules.</a></p>
  </section>
</Base>
