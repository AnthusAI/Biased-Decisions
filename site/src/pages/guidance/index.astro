---
// A short, evidence-linked checklist for deploying a fast decision model.
import Base from "../../layouts/Base.astro";
import { urls } from "../../lib/site.js";
import { C, curls, REPO_BLOB, evidence } from "../../lib/compliance.js";

const linkHref = (h) => (h === "methods" ? urls.methods() : urls.dim(h));
const before = evidence("shortlist-laya-attorney-500");
const after = evidence("twin-laya-attorney-500");
const description = "A short, evidence-linked checklist for deploying fast decision models in regulated decisions. Not legal advice.";
---
<Base title="Guidance: measuring and avoiding the risk" description={description} path={curls.guidance()} current={{ page: "guidance" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Guidance" }]}>
  <section class="wrap hero">
    <p class="kicker">Guidance · regulated decisions</p>
    <h1 class="display xl">Measuring and avoiding the risk</h1>
    <p class="deck">A short checklist for using a fast decision model where the decision matters. Measure the actual outcome, keep the version fixed, and check again when anything changes. The <a href={curls.howToFail()}>inversion page</a> asks the companion question: what could go wrong?</p>
    <p class="finding"><span class="finding-num">{after.ratio}</span><span class="finding-txt"><a href={after.href}>{after.sentence}</a>. Without averaging the ratio was <a href={before.href}>{before.ratio}</a>. The line is {C.shortlist.line.toFixed(2)}.</span></p>
    <div class="footnote risk-notice" role="note"><p>{C.notice}</p></div>
  </section>

  <section class="wrap section tight" id="checklist" aria-labelledby="checklist-h">
    <h2 class="display" id="checklist-h">Before deploying</h2>
    <ol class="checklist">
      {C.checklist.map((c) => <li>{c.text} <a href={`#${c.insight}`}>Why</a></li>)}
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="guidance-h">
    <h2 class="display sm" id="guidance-h">Why each check matters</h2>
    <div class="compact-cards">
      {C.insights.map((i) => (
        <article class="insight compact-card" id={i.id} aria-labelledby={`${i.id}-h`}>
          <h3 id={`${i.id}-h`}>{i.title} <a class="anchor" href={`#${i.id}`} aria-label={`Link to ${i.title}`}>#</a></h3>
          <p>{i.text}</p>
          <p class="card-links">{i.links.map((l, k) => <Fragment>{k ? " · " : ""}<a href={linkHref(l.href)}>{l.label}</a></Fragment>)}{i.links.length ? <span aria-hidden="true"> · </span> : null}{i.evidence.map((id, k) => <Fragment>{k ? ", " : ""}<a class="ev-link" href={evidence(id).href}>evidence {k + 1}</a></Fragment>)}</p>
        </article>
      ))}
    </div>
    <p class="note">For the rules and decisions this project has not yet measured, see the <a href={`${REPO_BLOB}${C.unmeasured[0].repo_ref.path}`}>pre-registrations</a>. {C.articles.map((a, k) => <Fragment>{k ? " · " : ""}<a href={a.url}>{a.title}</a></Fragment>)}</p>
  </section>
</Base>
