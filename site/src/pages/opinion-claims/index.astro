---
// Opinion and belief tests: does the model agree or disagree with a claim, with no decision involved at all.
import Base from "../../layouts/Base.astro";
import { pageIntroductions } from "../../lib/introductions.js";
import { opinionClaims, urls } from "../../lib/site.js";

const intro = pageIntroductions["opinion-claims"];
const pct = (value) => `${Number(value).toFixed(2)}%`;
---
<Base title={intro.title} description={intro.intro} path={`${urls.home()}opinion-claims/`} current={{ page: "opinion-claims" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Opinion and belief tests" }]}>
  <section class="wrap hero">
    <p class="kicker">Opinion and belief tests</p>
    <h1 class="display xl">{intro.title}</h1>
    <p class="deck">{intro.intro}</p>
  </section>

  <section class="wrap section" aria-labelledby="related-h">
    <h2 class="display" id="related-h">Looking for antisemitism or Israel-related tests?</h2>
    <p class="lede">Use the <a href={`${urls.home()}antisemitism-and-israel/`}>related-studies guide</a> to find the stereotype, Israeli-identity decision, and direct-opinion tests together. It also states plainly which Israel–Gaza tests do not exist here.</p>
  </section>

  <section class="wrap section" id="how" aria-labelledby="how-h">
    <h2 class="display" id="how-h">How this differs from our other tests</h2>
    <p class="lede">Our decision tests change one detail in a real decision and measure whether the answer moves. Our stereotype-question tests describe a hypothetical person and ask whether the model thinks a trait applies to them. This kind of test is different again: we put a claim directly to the model and ask whether it agrees, with no person, no decision and no hypothetical involved. It measures what the model will say when asked outright, not how it treats a person it is deciding about.</p>
  </section>

  {opinionClaims.results.length > 0
    ? <section class="wrap section" id="results" aria-labelledby="results-h">
        <h2 class="display" id="results-h">What the models were asked</h2>
        <p class="lede">Every model received this fixed question: <q>{opinionClaims.question}</q> It could answer <strong>yes</strong> or <strong>no</strong>. The figures below are the model’s probability of yes for each exact statement—not a judgment that the statement is true, nor a general measure of bias.</p>

        <h2 class="display" id="detail-h">Claim-by-claim results</h2>
        <p class="lede">Open a claim family to see all three statements, why they were included, and every model’s answer. Only the Jewish-conspiracy family has a registered comparison with a control family. The other families, including anti-Israel claims, are reported as direct-response rates only.</p>
        {opinionClaims.domains.map((domain) => <details class="claim-detail" id={domain.id}>
          <summary><strong class="opinion-claim-family">{domain.label}</strong><span class="opinion-claim-summary">3 exact statements · open the evidence</span></summary>
          <p class="note"><strong>Why these statements:</strong> {domain.source}</p>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`${domain.label} claim-by-claim model answers`}>
            <table class="cell-table">
              <thead><tr><th scope="col">exact statement</th>{opinionClaims.results.map((result) => <th scope="col">{result.label}: probability of yes</th>)}</tr></thead>
              <tbody>{domain.claims.map((claim) => <tr>
                <th scope="row"><q>{claim.text}</q></th>
                {opinionClaims.results.map((result) => {
                  const score = result.claims[`${domain.id}-${claim.id}`];
                  return <td>{score ? <strong>{pct(score.agree_pct)}</strong> : "not measured"}</td>;
                })}
              </tr>)}</tbody>
            </table>
          </div>
          {opinionClaims.results.some((result) => result.domains[domain.id]?.excess_pct !== undefined)
            ? <p class="note"><strong>Registered comparison:</strong> this family’s average is also shown against the non-Jewish conspiracy control. That comparison is not used for any other family.</p>
            : <p class="note"><strong>No comparison verdict:</strong> this family has no registered neutral counterpart, so the page does not label a rate as bias detected or not detected.</p>}
        </details>)}
        <p class="note">Read the <a href="https://github.com/AnthusAI/Biased-Decisions/blob/ebc3e5028ad4e16c8a6138ec1a1be821ed91713f/docs/opinion-claims-preregistration.md">study plan with sources and scoring rules</a>. Every displayed result is recomputed from saved answers.</p>
      </section>
    : <section class="wrap section" id="coming" aria-labelledby="coming-h">
        <h2 class="display sm" id="coming-h">No results published here yet</h2>
        <p class="lede">This is a new kind of test for this site, and we have not published results yet. When we do, each will link the exact claims asked and the sources documenting them.</p>
      </section>}
</Base>
