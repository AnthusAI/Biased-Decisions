---
// Opinion and belief tests: does the model agree or disagree with a claim, with no decision involved at all.
import Base from "../../layouts/Base.astro";
import { pageIntroductions } from "../../lib/introductions.js";
import { data, engines, urls, fmt, signed } from "../../lib/site.js";

const OC = data.opinion_claims;
const intro = pageIntroductions["opinion-claims"];
const claimText = Object.fromEntries(OC.domains.flatMap((d) => d.claims.map((c) => [`${d.id}-${c.id}`, c.text])));
const tested = engines.filter((en) => OC.results[en.id]);
---
<Base title={intro.title} description={intro.intro} path={`${urls.home()}opinion-claims/`} current={{ page: "opinion-claims" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Opinion and belief tests" }]}>
  <section class="wrap hero">
    <p class="kicker">Opinion and belief tests</p>
    <h1 class="display xl">{intro.title}</h1>
    <p class="deck">{intro.intro}</p>
    <div class="footnote risk-notice" role="note"><p>These are tests of what the models answer when asked directly. The claims include Holocaust denial and distortion; each is included only because a recognized source treats agreeing with it as documented antisemitism, and we quote each claim exactly so the test can be checked.</p></div>
  </section>

  <section class="wrap section" id="how" aria-labelledby="how-h">
    <h2 class="display" id="how-h">How this differs from our other tests</h2>
    <p class="lede">Our decision tests change one detail in a real decision and measure whether the answer moves. Our stereotype-question tests describe a hypothetical person and ask whether the model thinks a trait applies to them. This kind of test is different again: we put a claim directly to the model and ask whether it agrees, with no person, no decision and no hypothetical involved. It measures what the model will say when asked outright, not how it treats a person it is deciding about.</p>
  </section>

  <section class="wrap section" id="asked" aria-labelledby="asked-h">
    <h2 class="display" id="asked-h">What we asked</h2>
    <p class="lede">Fifteen claims, three for each of five domains. Each domain's three claims are worded differently but test the same underlying idea; we report the average and the range across the three, not a confidence interval, because three claims are too few to draw a reliable range from by resampling. Every claim traces to a source we read directly.</p>
    {OC.domains.map((d) => (
      <Fragment>
        <h3>{d.label}</h3>
        <p class="note">Source: {d.source}</p>
        <ul class="cite-list">{d.claims.map((c) => <li><q>{c.text}</q></li>)}</ul>
      </Fragment>
    ))}
  </section>

  {tested.length > 0
    ? <section class="wrap section" id="results" aria-labelledby="results-h">
        <h2 class="display" id="results-h">What each model said</h2>
        <p class="lede">For each domain, how often the model answered "yes, I agree" across its three claims, and the range between its lowest- and highest-agreeing claim. Where a domain has a matched, non-Jewish control (the conspiracy domain), we also show how much more often the model agreed with the Jewish-specific version.</p>
        {tested.map((en) => {
          const row = OC.results[en.id];
          return (
            <Fragment>
              <h3>{en.label}</h3>
              <ul class="cite-list">
                {OC.domains.map((d) => {
                  const r = row.domains[d.id];
                  const excess = d.excess_against && r.excess_pct != null
                    ? ` It agreed ${signed(r.excess_pct)} points more often than with the matched non-Jewish control claims.`
                    : "";
                  return <li><strong>{d.label}</strong>: agreed {fmt(r.agree_pct)}% of the time on average (range {fmt(r.lowest_pct)}% to {fmt(r.highest_pct)}% across its three claims).{excess}</li>;
                })}
              </ul>
            </Fragment>
          );
        })}
      </section>
    : <section class="wrap section" id="coming" aria-labelledby="coming-h">
        <h2 class="display sm" id="coming-h">No results published here yet</h2>
        <p class="lede">This is a new kind of test for this site, and we have not published results yet. When we do, each will link the exact claims asked and the sources documenting them.</p>
      </section>}

  <section class="wrap section" id="limits" aria-labelledby="limits-h">
    <h2 class="display sm" id="limits-h">What this does not show</h2>
    <ul class="unmeasured-list">
      <li>Each claim is asked once, in isolation, with no conversation around it; a model's answer inside a longer conversation, or with a system prompt, could differ.</li>
      <li>The non-Jewish conspiracy claims are a control for a general willingness to agree with any conspiracy claim, not a study of those conspiracy theories in their own right.</li>
      <li>A high agree rate here says the model will state agreement with a claim when asked directly. It says nothing about the people the claim is about.</li>
    </ul>
  </section>
</Base>
