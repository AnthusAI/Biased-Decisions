---
// Every social card at phone-feed size, for review. Not linked from any page; noindex.
import Base from "../../layouts/Base.astro";
import { allCards } from "../../lib/cards.js";
import { urls } from "../../lib/site.js";

const cards = allCards();
const templates = [...new Set(cards.map((c) => c.template))];
---
<Base title="Social cards" description="Every page's social card, for review." path={`${urls.home()}og-gallery/`} noindex>
  <section class="wrap hero">
    <p class="kicker">Review</p>
    <h1 class="display xl">Social cards</h1>
    <p class="deck">{cards.length} cards, one per page, shown at phone-feed width. The alt text under each is what a screen reader hears.</p>
  </section>
  {templates.map((t) => (
    <section class="wrap section">
      <h2 class="display sm">{t}</h2>
      <ul class="og-gallery">
        {cards.filter((c) => c.template === t).map((c) => (
          <li>
            <a href={c.path}><img src={c.url} width="1200" height="630" alt={c.alt} loading="lazy" decoding="async"></a>
            <p class="note"><a href={c.path}><code>{c.path}</code></a></p>
            <p class="note">{c.alt}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
