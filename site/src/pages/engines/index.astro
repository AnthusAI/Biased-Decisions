---
import { pageIntroductions } from "../../lib/introductions.js";
import Base from "../../layouts/Base.astro";
import EngineName from "../../components/EngineName.astro";
import { data, engineById, urls, fmt, signed, size, largestBias } from "../../lib/site.js";
import { aboutModel } from "./_about.js";

const rows = data.overall.rows;
const testedCount = rows.filter((r) => r.measured_on > 0).length;
const pendingCount = rows.length - testedCount;
const description = `${testedCount} tested AI models on the Biased-Decisions leaderboard, with ${pendingCount} not yet tested. Each model answers a question about a person from a short text.`;
---
<Base title="Models" description={description} path={urls.engines()} current={{ page: "engines" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Models" }]}>
  <section class="wrap hero">
    <p class="kicker">Models</p>
    <h1 class="display xl">{pageIntroductions.models.title}</h1>
    <p class="deck">We test AI models that read a short text and make a quick judgment about a person. Does the model’s answer change when we change a name, a pronoun or another personal detail? Here you can compare the {testedCount} models tested so far and open each one’s results.</p>
    {pendingCount > 0 && <p class="note">{pendingCount} {pendingCount === 1 ? "model is" : "models are"} not yet tested.</p>}
    <p class="note">Models are listed in a fixed order, not ranked: compare them characteristic by characteristic on each model's page and on the leaderboard. <a href={urls.methods()}>How the comparison works</a>.</p>
  </section>
  <section class="wrap section sec-prose tight">
    <ol class="overall">
      {rows.map((r, i) => {
        const en = engineById[r.engine];
        const largest = largestBias(r.engine);
        return (
          <li class="ov-row ov-simple">
            <div class="ov-name">
              <EngineName engine={en} href={urls.engine(en.id)} />
              {r.measured_on > 0 && <div class="ov-mean">a clear effect on <strong>{r.detected.length} of the {r.measured_on}</strong> characteristics it was tested on · tested on {r.measured_on} of {data.overall.n_dimensions}</div>}
              <div class="ov-mean">{r.measured_on === 0 ? "Not yet tested" : largest > 0 ? <Fragment>largest effect: <strong>{size(largest)} percentage points</strong> beyond the control edit</Fragment> : "no clear effect on any characteristic tested"}</div>
            </div>
            <p class="ov-about">{aboutModel(en)}</p>
          </li>
        );
      })}
    </ol>
  </section>
</Base>
