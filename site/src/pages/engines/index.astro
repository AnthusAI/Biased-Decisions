---
import Base from "../../layouts/Base.astro";
import EngineName from "../../components/EngineName.astro";
import { data, engineById, urls, fmt, signed, largestBias } from "../../lib/site.js";
import { aboutModel } from "./_about.js";

const rows = data.overall.rows;
const description = `The ${rows.length} AI models on the Biased-Decisions leaderboard, most biased first. Each model answers a yes-or-no question about a person from a short text, and each has a page for every characteristic we tested it on.`;
---
<Base title="Models" description={description} path={urls.engines()} current={{ page: "engines" }}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Models" }]}>
  <section class="wrap hero">
    <p class="kicker">Models</p>
    <h1 class="display xl">Every model we tested</h1>
    <p class="deck">A model is software that reads a text and answers a question about it. We tested {rows.length}, listed most biased first. The order comes from each model's average place over the characteristics where it could be compared with another model. Each effect is measured beyond a control edit: a harmless change of the same size, such as adding "a keen cyclist". Each model has a page, and a page for each characteristic we tested it on. <a href={urls.methods()}>How we measure this</a>.</p>
  </section>
  <section class="wrap section tight">
    <ol class="overall">
      {rows.map((r, i) => {
        const en = engineById[r.engine];
        const largest = largestBias(r.engine);
        return (
          <li class="ov-row ov-simple">
            <div class="ov-place">{i + 1}</div>
            <div class="ov-name">
              <EngineName engine={en} href={urls.engine(en.id)} />
              <div class="ov-mean">average place <strong>{fmt(r.mean_rank)}</strong> over the {r.ranked_on} characteristics where it was compared · tested on {r.measured_on} of {data.overall.n_dimensions}</div>
              <div class="ov-mean">{largest > 0 ? <Fragment>largest effect: <strong>{signed(largest)} percentage points</strong> beyond the control edit</Fragment> : "no clear effect on any characteristic tested"}</div>
            </div>
            <p class="ov-about">{aboutModel(en)}</p>
          </li>
        );
      })}
    </ol>
  </section>
</Base>
