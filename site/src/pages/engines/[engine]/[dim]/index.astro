---
// One engine on one dimension: where it stands on the board, every group, question or task it
// was measured on, and the predictions made for it.
import Base from "../../../../layouts/Base.astro";
import RegWarn from "../../../../components/RegWarn.astro";
import RiskPanel from "../../../../components/RiskPanel.astro";
import Chart from "../../../../components/Chart.astro";
import EngineName from "../../../../components/EngineName.astro";
import FacetTable from "../../../../components/FacetTable.astro";
import Matrix from "../../../../components/Matrix.astro";
import { engines, dimensions, urls, facetHref, multiGroup, multiItem, forestRows, groupLabel, itemLabel, place,
  fmt, signed, int, plural } from "../../../../lib/site.js";
import { introModel } from "../../_about.js";

export function getStaticPaths() {
  return engines.flatMap((en) => dimensions.map((dim) => ({ params: { engine: en.id, dim: dim.id }, props: { en, dim } })));
}
const { en, dim } = Astro.props;
const bd = dim.breakdown;
const c = dim.cells[en.id];
const measured = c.status === "measured";
const twoAxes = multiGroup(dim) && multiItem(dim);
const oneAxis = !twoAxes && (multiGroup(dim) || multiItem(dim));
const nMeasured = Object.values(dim.cells).filter((x) => x.status === "measured").length;
// What the reader calls each part of a characteristic: a "task" is a decision the model makes.
const kindWord = (k) => (k === "task" ? "decision" : k);
const kindPlural = (k) => (k === "task" ? "decisions" : plural(k));
const charts = {};
if (measured && oneAxis) {
  const byGroup = multiGroup(dim);
  charts.forest = { type: "forest", engines: [en.id],
    rows: forestRows(dim, bd.cells, (x) => (byGroup ? groupLabel(dim, x.group) : itemLabel(dim, x.item)), (x) => urls.at(dim, x.group, x.item)),
    label: `${en.label}, ${dim.long}: every ${byGroup ? kindWord(bd.group_kind) : kindWord(bd.item_kind)}`, axisLabel: "beyond the control edit, percentage points" };
}
const status = !measured ? "not tested"
  : !dim.board.contested ? (c.detected ? "the only model tested" : "the only model tested; no clear effect")
  : c.detected ? `place ${place(dim.board, en.id)} of ${nMeasured}, where 1 is most biased` : "no clear effect";
const title = `${en.label} · ${dim.long}`;
const facetWord = kindWord(dim.facet_kind);
const description = measured
  ? `${en.label} on ${dim.long.toLowerCase()}: ${status}${c.detected ? `. Its largest effect is ${signed(c.headline.value)} percentage points beyond a harmless control edit, on ${c.headline.facet_label}` : ""}. Every ${twoAxes ? `${kindWord(bd.group_kind)} and ${kindWord(bd.item_kind)}` : facetWord} we tested, with its range.`
  : `${en.label} has not been tested on ${dim.long.toLowerCase()}. It is shown as missing, never as zero.`;
---
<Base title={title} description={description} path={urls.engineDim(en.id, dim.id)} current={{ page: "engine-dim", engine: en.id, dim: dim.id }} charts={charts}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Models", href: urls.engines() }, { label: en.label, href: urls.engine(en.id) }, { label: dim.long }]}>
  <section class="wrap hero dim-hero">
    <p class="kicker"><a href={urls.engine(en.id)}>{en.label}</a> · <a href={urls.dim(dim.id)}>{dim.long}</a></p>
    <h1 class="display xl eng-title"><span class="eng-dot" style={`background:var(--eng-${en.id})`}></span>{en.label} <span class="h-x">on</span> {dim.label.toLowerCase()}</h1>
    <p class="deck">{introModel(en)} {measured
      ? <Fragment>{dim.id === "option-order" ? "We listed the two answer options the other way round" : `We changed one ${dim.label.toLowerCase()} detail in each text`} and counted how far {en.label}'s answers moved. We compare that with a control edit: a harmless change of the same size. Only the part beyond the control edit counts.</Fragment>
      : <Fragment>We have not tested {en.label} on {dim.label.toLowerCase()}. It is shown as missing, never as zero, and it is marked incomplete on the main board.</Fragment>}</p>
    <RegWarn dim={dim} />
    {measured && (
      <div class="eng-stats">
        <div><span class="stat-k">Place</span><span class="stat-v">{c.detected && dim.board.contested ? place(dim.board, en.id) : c.detected ? "only" : "—"}</span><span class="stat-s">{status}</span></div>
        <div><span class="stat-k">Largest effect</span><span class="stat-v">{signed(c.headline.value)}</span><span class="stat-s">percentage points beyond the control edit, range {fmt(c.headline.lo)} to {fmt(c.headline.hi)}, on {c.headline.facet_label}</span></div>
        <div><span class="stat-k">Clear effects</span><span class="stat-v">{c.n_facets_detected} / {c.n_facets}</span><span class="stat-s">{kindPlural(dim.facet_kind)} where the effect is clear of the control edit; {int(c.n)} texts tested</span></div>
      </div>
    )}
  </section>

  <RiskPanel dim={dim} engineId={en.id} place={`${en.label} on ${dim.label.toLowerCase()}`} />

  {measured && twoAxes && (
    <section class="wrap section">
      <h2 class="display">Every {kindWord(bd.group_kind)}, every {kindWord(bd.item_kind)}</h2>
      <p class="lede">Each square is {en.label}'s effect beyond the control edit for one {kindWord(bd.group_kind)} and one {kindWord(bd.item_kind)}. Select a square for the full result, or a {kindWord(bd.group_kind)} or a {kindWord(bd.item_kind)} to compare every model.</p>
      <Matrix dim={dim} engineId={en.id} caption={`${en.label}, ${dim.long}: every ${kindWord(bd.group_kind)} by every ${kindWord(bd.item_kind)}`} />
    </section>
  )}

  {measured && oneAxis && (
    <section class="wrap section">
      <h2 class="display">Every {multiGroup(dim) ? kindWord(bd.group_kind) : kindWord(bd.item_kind)}, most biased first</h2>
      <p class="lede">{en.label}'s effect beyond the control edit for each {multiGroup(dim) ? kindWord(bd.group_kind) : kindWord(bd.item_kind)}. Each is shown with the range we are 95% sure the true value lies in.</p>
      <Chart id="forest" />
    </section>
  )}

  {measured && (
    <section class="wrap section">
      <h2 class="display">Every {facetWord}, in a table</h2>
      <FacetTable dim={dim} facets={c.facets} headline={c.headline.facet} detected={c.detected} facetKind={dim.facet_kind}
        caption={`${en.label}, ${dim.long}: the result for each ${facetWord}`}
        rowHref={!multiGroup(dim) && !multiItem(dim) ? null : (f) => `${facetHref(dim, f.id)}#${en.id}`} />
      {twoAxes && <p class="note">Each row shows the largest result over all the {kindPlural(bd.group_kind)}. The grid above has every square.</p>}
    </section>
  )}

  <section class="wrap section">
    <nav class="chips" aria-label={`${en.label} on other characteristics`}>
      <span class="chips-h">{en.label} on</span>
      {dimensions.filter((d) => d.id !== dim.id).map((d) => <a href={urls.engineDim(en.id, d.id)} class={d.cells[en.id].status === "measured" ? null : "dim-miss"}>{d.label}</a>)}
    </nav>
    <nav class="chips" aria-label={`Other models on ${dim.long}`}>
      <span class="chips-h">{dim.label}:</span>
      {engines.filter((e) => e.id !== en.id).map((e) => <a href={urls.engineDim(e.id, dim.id)}>{e.label}</a>)}
      <a href={urls.dim(dim.id)}>every model</a>
    </nav>
  </section>
</Base>
