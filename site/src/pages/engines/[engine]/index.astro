---
import Base from "../../../layouts/Base.astro";
import Chart from "../../../components/Chart.astro";
import { data, engines, dimensions, urls, engineSeries, globalSpiderMax, niceMax, place, fmt, signed , unit } from "../../../lib/site.js";
import { rankText } from "../../../scripts/util.js";
import { aboutModel, introModel } from "../_about.js";

export function getStaticPaths() {
  return engines.map((en) => ({ params: { engine: en.id }, props: { en } }));
}
const { en } = Astro.props;
const row = data.overall.rows.find((r) => r.engine === en.id);
const measuredDims = dimensions.filter((d) => d.cells[en.id].status === "measured");
const missingDims = dimensions.filter((d) => d.cells[en.id].status !== "measured");
const axes = dimensions.map((d) => ({ id: d.id, label: d.label, href: urls.engineDim(en.id, d.id) }));
let stripMax = 0;
for (const d of measuredDims) stripMax = Math.max(stripMax, d.cells[en.id].headline.hi);
stripMax = niceMax(stripMax);
const charts = {
  spider: { type: "spider", axes, series: [engineSeries(en.id)], max: globalSpiderMax(), label: `${en.label}: its effect beyond the control edit on every characteristic` },
  ...Object.fromEntries(measuredDims.map((d) => {
    const c = d.cells[en.id];
    return [`strip-${d.id}`, { type: "strip", ...c.headline, detected: c.detected, engine: en.id, max: stripMax, min: c.headline.lo < 0 ? c.headline.lo : 0 }];
  })),
};
const nDetected = measuredDims.filter((d) => d.cells[en.id].detected).length;
const worst = measuredDims.filter((d) => d.cells[en.id].detected).sort((a, b) => b.cells[en.id].headline.value - a.cells[en.id].headline.value)[0];
const description = measuredDims.length === 0
  ? `${en.label} has not yet been tested on any of the ${dimensions.length} characteristics. No average place is available.`
  : `${en.label} on the Biased-Decisions leaderboard: a clear effect on ${nDetected} of the ${row.measured_on} characteristics we tested it on${worst ? `; its largest is ${signed(worst.cells[en.id].headline.value)} percentage points beyond a harmless control edit, on ${worst.label.toLowerCase()}` : ""}. Average place ${fmt(row.mean_rank)}, where 1 is most biased.`;
const uOf = (d, h) => (h && h.raw && h.raw.unit) || unit(d);
---
<Base title={en.label} description={description} path={urls.engine(en.id)} current={{ page: "engine", engine: en.id }} charts={charts}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Models", href: urls.engines() }, { label: en.label }]}>
  <section class="wrap hero eng-hero">
    <p class="kicker">Model</p>
    <h1 class="display xl eng-title"><span class="eng-dot" style={`background:var(--eng-${en.id})`}></span>{en.label}</h1>
    <p class="deck">{introModel(en)} {measuredDims.length === 0 ? `We have not yet tested ${en.label} on any characteristics. Results will appear here when measurements are available.` : "We test whether its judgments change when a text gives the same person a different gender, name or other personal detail. This page brings together its results and shows where it has not been tested."}</p>
    <p class="note">We compare each change with a control edit: an unrelated change, or asking the same question again. That helps separate the effect of a personal detail from other changes in the model’s answers.</p>
    <div class="eng-stats">
      <div><span class="stat-k">Average place</span><span class="stat-v">{row.mean_rank === null ? "—" : fmt(row.mean_rank)}</span><span class="stat-s">{measuredDims.length === 0 ? "Not yet ranked" : `over the ${row.ranked_on} characteristics where it was compared with another model; 1 = most biased`}</span></div>
      <div><span class="stat-k">Tested on</span><span class="stat-v">{row.measured_on} / {dimensions.length}</span><span class="stat-s">{row.incomplete ? "incomplete: see below" : "every characteristic"}</span></div>
      <div><span class="stat-k">Clear effect on</span><span class="stat-v">{measuredDims.length === 0 ? "—" : nDetected}</span><span class="stat-s">{measuredDims.length === 0 ? "Not yet tested" : "of the characteristics it was tested on"}</span></div>
    </div>
  </section>
  <section class="wrap section">
    <h2 class="display">The shape of its bias</h2>
    <p class="lede">Each spoke is one characteristic. The farther the shape reaches along a spoke, the larger {en.label}'s effect there, beyond the control edit. Every model's page uses the same scale. Bigger is worse. A dashed spoke was never tested, and the shape breaks there instead of dropping to zero.</p>
    <Chart id="spider" cls="chart-box spider-big" />
  </section>
  <section class="wrap section">
    <h2 class="display">Every result</h2>
    <p class="lede">{measuredDims.length === 0
      ? `No results are available because we have not yet tested ${en.label}. This page will show each characteristic when measurements are available.`
      : <Fragment>{en.label}'s largest effect on each characteristic, beyond the control edit, on one scale from 0 to {stripMax} percentage points. The vertical line is the control edit. Each result is shown with the range we are 95% sure the true value lies in. Select a characteristic for {en.label}'s full results on it.</Fragment>}</p>
    <ol class="eng-cells">
      {measuredDims.map((d) => {
        const c = d.cells[en.id];
        const pos = row.positions[d.id];
        const n = Object.values(d.cells).filter((x) => x.status === "measured").length;
        const status = !d.board.contested ? (c.detected ? "the only model tested" : "the only model tested; no clear effect")
          : c.detected ? `place ${place(d.board, en.id)} of ${n} (counts as ${rankText(pos)} toward its average place)` : `no clear effect (counts as ${rankText(pos)} toward its average place)`;
        const u = uOf(d, c.headline);
        return (
          <li>
            <a href={urls.engineDim(en.id, d.id)} class="ec-name">{d.label}</a>
            <span class={`ec-status${c.detected ? "" : " nd"}`}>{status}</span>
            <Chart id={`strip-${d.id}`} cls="chart-box strip-box" />
            <span class="ec-v">{signed(c.headline.value)} percentage points<span class="ci-t"> (range {fmt(c.headline.lo)} to {fmt(c.headline.hi)})</span><span class="ec-f">{c.headline.facet_label}; control edit {fmt(c.headline.floor_value)}{u.trim() === "%" ? " in 100" : " points"}</span></span>
          </li>
        );
      })}
    </ol>
  </section>
  <section class="wrap section">
    <h2 class="display">About this model</h2>
    <p>{aboutModel(en)}</p>
    {en.builds && <details><summary>Versions tested</summary><ul>{en.builds.map((b) => <li><strong>{b.label}</strong> ({b.package}, runs on {b.runs_on}): {b.note}.</li>)}</ul></details>}
  </section>
  <section class="wrap section">
    <h2 class="display">Where it was not tested</h2>
    {missingDims.length
      ? <Fragment>
          <p class="lede">We have not tested {en.label} on {missingDims.length} of the {dimensions.length} characteristics. None of them counts toward its average place, and none is counted as zero.</p>
          <ul class="miss-list">{missingDims.map((d) => <li><span class="hatch"></span><a href={urls.dim(d.id)}>{d.long}</a></li>)}</ul>
        </Fragment>
      : <p class="lede">Tested on every characteristic.</p>}
  </section>
</Base>
