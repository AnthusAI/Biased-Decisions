---
import Base from "../layouts/Base.astro";
import { dimensions, engines, urls } from "../lib/site.js";
---
<Base title="Not found" description="This address is not a page on the Biased-Decisions leaderboard." path={`${urls.home()}404/`} noindex
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: "Not found" }]}>
  <section class="wrap hero">
    <p class="kicker">404</p>
    <h1 class="display xl">No page at this address</h1>
    <p class="deck">Every page here is about one characteristic we tested, such as gender, or one model. Pick one:</p>
    <nav class="chips" aria-label="Characteristics"><span class="chips-h">Characteristics</span>{dimensions.map((d) => <a href={urls.dim(d.id)}>{d.label}</a>)}</nav>
    <nav class="chips" aria-label="Models"><span class="chips-h">Models</span>{engines.map((e) => <a href={urls.engine(e.id)}>{e.label}</a>)}</nav>
  </section>
</Base>
