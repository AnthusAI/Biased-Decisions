---
import Base from "../../layouts/Base.astro";
import Board from "../../components/Board.astro";
import Chart from "../../components/Chart.astro";
import EngineName from "../../components/EngineName.astro";
import FacetTable from "../../components/FacetTable.astro";
import Prereg from "../../components/Prereg.astro";
import Matrix from "../../components/Matrix.astro";
import Example from "../../components/Example.astro";
import Chip from "../../components/Chip.astro";
import { dimensions, engines, urls, boardPayload, describeDim, facetHref, multiGroup, multiItem, niceMax, unit,
  fmt, signed, int, cap, forestRows, groupLabel, itemLabel } from "../../lib/site.js";

export function getStaticPaths() {
  return dimensions.map((dim) => ({ params: { dim: dim.id }, props: { dim } }));
}
const { dim } = Astro.props;
const bd = dim.breakdown;
const twoAxes = multiGroup(dim) && multiItem(dim);
const oneAxis = !twoAxes && (multiGroup(dim) || multiItem(dim));
const single = !multiGroup(dim) && !multiItem(dim);
const payload = boardPayload(dim);
const charts = { board: { type: "board", dim: payload } };
const facets = dim.facets;
if (facets.length < 3) charts.versus = { type: "versus", dim: { ...payload, cells: Object.fromEntries(Object.entries(payload.cells)) } };
let spiderMax = 0;
const series = engines.filter((en) => dim.cells[en.id].status === "measured").map((en) => {
  const values = {};
  for (const f of dim.cells[en.id].facets) {
    values[f.id] = f.status === "measured" ? { status: "measured", value: f.excess.value, lo: f.excess.lo, hi: f.excess.hi, detected: f.detected, attributable: f.attributable } : { status: "missing" };
    if (f.status === "measured") spiderMax = Math.max(spiderMax, f.excess.value);
  }
  return { engine: en.id, values };
});
if (facets.length >= 3) {
  charts.spider = { type: "spider", axes: facets.map((f) => ({ id: f.id, label: f.label, href: facetHref(dim, f.id) })), series, max: niceMax(spiderMax || 1),
    label: `${dim.long}: excess over the floor per ${dim.facet_kind} and engine`,
    hrefs: Object.fromEntries(series.map((sr) => [sr.engine, Object.fromEntries(facets.map((f) => [f.id, `${facetHref(dim, f.id)}#${sr.engine}`]))])) };
}
if (oneAxis) {
  const byGroup = multiGroup(dim);
  charts.forest = { type: "forest", rows: forestRows(dim, bd.cells, (c) => (byGroup ? groupLabel(dim, c.group) : itemLabel(dim, c.item)), (c) => urls.at(dim, c.group, c.item)),
    label: `${dim.long}: every ${byGroup ? bd.group_kind : bd.item_kind}, every engine, excess over the floor`, axisLabel: `excess over the floor, ${unit(dim).trim() === "%" ? "points" : "points"}` };
}
const singleCell = single ? bd.cells[0] : null;
const kindWord = twoAxes ? `${bd.group_kind} and ${bd.item_kind}` : multiGroup(dim) ? bd.group_kind : bd.item_kind;
const plural = (k) => (k === "nationality" ? "nationalities" : k === "religion" ? "religions" : `${k}s`);
---
<Base title={dim.long} description={describeDim(dim)} path={urls.dim(dim.id)} current={{ page: "dimension", dim: dim.id }} charts={charts}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: dim.long }]}>
  <section class="wrap hero dim-hero">
    <p class="kicker">{dim.source === "batch2-staging" ? "Dimension · staged batch-2 data" : "Dimension"}</p>
    <h1 class="display xl">{dim.long}</h1>
    <dl class="defs">
      <div><dt>The cue</dt><dd>{dim.cue}</dd></div>
      <div><dt>The floor</dt><dd>{dim.floor}</dd></div>
      <div><dt>Ranked on</dt><dd>Excess: {dim.excess}.</dd></div>
    </dl>
    {dim.notes.length > 0 && <div class="footnote" role="note">{dim.notes.map((n) => <p>{n}</p>)}</div>}
  </section>

  <Board board={dim.board} heads={dim.cells} unit={unit(dim)} facetKind={dim.facet_kind} chartId="board" hrefFor={(e) => urls.engineDim(e, dim.id)} />

  {twoAxes && (
    <section class="wrap section" id="breakdown">
      <h2 class="display">Every {bd.group_kind}, every {bd.item_kind}</h2>
      <p class="lede">The headline above is the largest of these cells. Each cell is one {bd.group_kind} asked one {bd.item_kind}, ranked on its own; select a {bd.group_kind} for its {bd.item_kind}s, a {bd.item_kind} for every {bd.group_kind}, or a cell for the full measurement.</p>
      <Matrix dim={dim} caption={`${dim.long}: every ${bd.group_kind} by every ${bd.item_kind}`} />
      <nav class="chips" aria-label={`${cap(plural(bd.group_kind))}`}><span class="chips-h">{cap(plural(bd.group_kind))}</span>{bd.groups.map((g) => <a href={urls.at(dim, g.id, null)}>{g.label}</a>)}</nav>
      <nav class="chips" aria-label={`${cap(bd.item_kind)}s`}><span class="chips-h">{cap(bd.item_kind)}s</span>{bd.items.map((i) => <a href={urls.at(dim, null, i.id)}>{i.label}</a>)}</nav>
    </section>
  )}

  {oneAxis && (
    <section class="wrap section" id="breakdown">
      <h2 class="display">Every {kindWord}, ranked</h2>
      <p class="lede">Each {kindWord} ranked on its own, most biased first: every engine's excess over that {kindWord}'s floor with its 95% interval. Filled: detected. Hollow: the interval includes the floor. Select a {kindWord} for its page.</p>
      <div data-legend={engines.filter((e) => dim.cells[e.id].status === "measured").map((e) => e.id).join(",")}></div>
      <Chart id="forest" />
    </section>
  )}

  {facets.length < 3 && (
    <section class="wrap section">
      <h2 class="display">Measurement against floor</h2>
      <p class="lede">Each engine's measurement (coloured, with its 95% interval) above the floor it is read against (grey band: the floor's own interval). An engine is detected only when its interval clears the floor's point estimate.</p>
      <Chart id="versus" />
    </section>
  )}

  {facets.length >= 3 && (
    <section class="wrap section">
      <h2 class="display">The shape across {dim.facet_kind}s</h2>
      <p class="lede">One axis per {dim.facet_kind}; radius is the excess over that {dim.facet_kind}'s floor, so outward is worse{twoAxes ? ` (for each ${dim.facet_kind}, the largest over the ${plural(bd.group_kind)})` : ""}. Hollow vertices: no bias detected. A polygon is broken where the engine was not measured.</p>
      <div data-legend={series.map((s) => s.engine).join(",")}></div>
      <Chart id="spider" cls="chart-box spider-big" />
    </section>
  )}

  {singleCell && singleCell.example && (
    <section class="wrap section">
      <Example example={singleCell.example} note={bd.example_note} />
    </section>
  )}

  <section class="wrap section" id="engines">
    <h2 class="display">Each engine's {dim.facet_kind} table</h2>
    <p class="lede">One table per engine: every number with its interval, the floor it is read against, the committed files it replays from, and the pre-registered prediction beside what happened. Each engine also has its own page for this dimension.</p>
    {engines.map((en) => {
      const c = dim.cells[en.id];
      const measured = c.status === "measured";
      return (
        <details id={en.id} class={`cell${measured ? "" : " missing"}`}>
          <summary>
            <EngineName engine={en} />
            {measured
              ? <span class="sum-v">{c.detected ? `${signed(c.headline.value)} pp over the floor, ${c.headline.facet_label}` : "no bias detected at this floor"}<span class="sum-n"> · {c.n_facets} {dim.facet_kind}{c.n_facets === 1 ? "" : "s"} measured</span></span>
              : <span class="sum-v muted">not measured on this dimension</span>}
          </summary>
          {measured
            ? <Fragment>
                <FacetTable dim={dim} facets={c.facets} headline={c.headline.facet} detected={c.detected} facetKind={dim.facet_kind}
                  caption={`${en.label}, ${dim.long}: per-${dim.facet_kind} measurements`} rowHref={single ? null : (f) => `${facetHref(dim, f.id)}#${en.id}`} />
                {c.prereg && c.prereg.length > 0
                  ? <Prereg dim={dim} rows={c.prereg} showEngine={false} />
                  : <p class="note">No pre-registered prediction covers this cell.</p>}
                <p class="more-link"><a href={urls.engineDim(en.id, dim.id)}>{en.label} on {dim.long.toLowerCase()}: its own page</a></p>
              </Fragment>
            : <p class="note">{en.label} has no record for this dimension. It is shown as missing, never as zero, and it is flagged incomplete on the overall board.</p>}
        </details>
      );
    })}
  </section>

  {bd.pending && bd.pending.length > 0 && (
    <section class="wrap section">
      <h2 class="display sm">Predicted, not yet measured</h2>
      <Prereg dim={dim} rows={bd.pending} heading="Predictions for engines that have not answered yet" />
    </section>
  )}
</Base>
