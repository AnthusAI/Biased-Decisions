---
import { categoryIntro } from "../../lib/introductions.js";
import Base from "../../layouts/Base.astro";
import RegWarn from "../../components/RegWarn.astro";
import RiskPanel from "../../components/RiskPanel.astro";
import NeutralDirection from "../../components/NeutralDirection.astro";
import NeutralCost from "../../components/NeutralCost.astro";
import Board from "../../components/Board.astro";
import Chart from "../../components/Chart.astro";
import EngineName from "../../components/EngineName.astro";
import FacetTable from "../../components/FacetTable.astro";
import Matrix from "../../components/Matrix.astro";
import Example from "../../components/Example.astro";
import Chip from "../../components/Chip.astro";
import HowMeasured from "../../components/HowMeasured.astro";
import ModelsLine from "../../components/ModelsLine.astro";
import { kindName, kindNames, measureOf } from "../../scripts/util.js";
import { data, allDimensions, engines, urls, boardPayload, describeDim, facetHref, multiGroup, multiItem, niceMax, unit,
  fmt, signed, int, cap, forestRows, groupLabel, itemLabel } from "../../lib/site.js";

export function getStaticPaths() {
  return allDimensions.map((dim) => ({ params: { dim: dim.id }, props: { dim } }));
}
const { dim } = Astro.props;
const bd = dim.breakdown;
const twoAxes = multiGroup(dim) && multiItem(dim);
const oneAxis = !twoAxes && (multiGroup(dim) || multiItem(dim));
const single = !multiGroup(dim) && !multiItem(dim);
const payload = { ...boardPayload(dim), measure_plain: dim.measure_plain, raw_unit: dim.raw_unit };
const charts = { board: { type: "board", dim: payload } };
const facets = dim.facets;
if (facets.length < 3) charts.versus = { type: "versus", dim: { ...payload, cells: Object.fromEntries(Object.entries(payload.cells)) } };
let spiderMax = 0;
const series = engines.filter((en) => dim.cells[en.id].status === "measured").map((en) => {
  const values = {};
  for (const f of dim.cells[en.id].facets) {
    values[f.id] = f.status === "measured" ? { status: "measured", value: f.excess.value, lo: f.excess.lo, hi: f.excess.hi, detected: f.detected, attributable: f.attributable } : { status: "missing" };
    if (f.status === "measured") spiderMax = Math.max(spiderMax, f.excess.value);
  }
  return { engine: en.id, values };
});
if (facets.length >= 3) {
  charts.spider = { type: "spider", axes: facets.map((f) => ({ id: f.id, label: f.label, href: facetHref(dim, f.id) })), series, max: niceMax(spiderMax || 1),
    label: `${dim.label}: how far each model moved beyond the control edit, by ${kindName(dim.facet_kind)}`,
    hrefs: Object.fromEntries(series.map((sr) => [sr.engine, Object.fromEntries(facets.map((f) => [f.id, `${facetHref(dim, f.id)}#${sr.engine}`]))])) };
}
if (oneAxis) {
  const byGroup = multiGroup(dim);
  charts.forest = { type: "forest", rows: forestRows(dim, bd.cells, (c) => (byGroup ? groupLabel(dim, c.group) : itemLabel(dim, c.item)), (c) => urls.at(dim, c.group, c.item)),
    label: `${dim.label}: every ${kindName(byGroup ? bd.group_kind : bd.item_kind)}, every model, beyond the control edit`, axisLabel: "beyond the control edit, percentage points" };
}
const singleCell = single ? bd.cells[0] : null;
const kindWord = twoAxes ? `${kindName(bd.group_kind)} and ${kindName(bd.item_kind)}` : kindName(multiGroup(dim) ? bd.group_kind : bd.item_kind);
const plural = (k) => kindNames(k);
const G = kindName(bd.group_kind), I = kindName(bd.item_kind), F = kindName(dim.facet_kind);
const introduction = categoryIntro(dim);
const allFacets = engines.flatMap((en) => dim.cells[en.id].facets || []);
---
<Base title={introduction.title} description={introduction.intro} path={urls.dim(dim.id)} current={{ page: "dimension", dim: dim.id }} charts={charts}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: dim.label }]}>
  <section class="wrap hero dim-hero">
    <p class="kicker">AI bias tests · {dim.label}</p>
    <h1 class="display xl">{introduction.title}</h1>
    <p class="deck">{introduction.intro}</p>
    <p class="lede">{introduction.detail}</p>
    <RegWarn dim={dim} />
    <p class="note">For every real edit we also made a control edit: a harmless change of the same size, or simply asking again. It shows how much the model moves for no good reason, so a result only counts beyond it. This page's control edit is described below.</p>
    <ModelsLine />
    <dl class="defs">
      <div><dt>What we changed</dt><dd>{dim.cue}</dd></div>
      <div><dt>The control edit</dt><dd>{dim.floor}</dd></div>
      <div><dt>What we measured</dt><dd>{cap(measureOf(dim))}.</dd></div>
      <div><dt>How we rank the models</dt><dd>By how much more each model moved for the real edit than for the control edit, in percentage points. Most biased first.</dd></div>
    </dl>
    {dim.notes.length > 0 && <div class="footnote" role="note">{dim.notes.map((n) => <p>{n}</p>)}</div>}
  </section>

  <Board heading="Compare the AI models" board={dim.board} heads={dim.cells} unit={unit(dim)} facetKind={dim.facet_kind} chartId="board" hrefFor={(e) => urls.engineDim(e, dim.id)} />

  <RiskPanel dim={dim} />

  {dim.id === "gender" && data.neutral.rows.length > 0 && (
    <Fragment>
      <section class="wrap section" id="direction">
        <h2 class="display">Which gendered words change Laya’s answer?</h2>
        <p class="lede">The pronoun swap shows that one word can change the model's answer. It does not show which word pulls the answer away. So we also rewrote each biography with no gendered pronoun at all and asked again. Where that neutral answer falls, between the answer for <q>she</q> and the answer for <q>he</q>, shows which word moves the model.</p>
        <NeutralDirection engineId="laya" />
      </section>
      <section class="wrap section" id="cost">
        <h2 class="display">What happens when we remove gender from the biographies?</h2>
        <p class="lede">Taking gender out narrows the gap between the women and men who reach the shortlist. It also changes how often the model matches the job the dataset lists for each person. Here are the two shortlists we can build from real biographies, each read four ways.</p>
        <NeutralCost task="paralegal-attorney" positive="attorney" />
        <NeutralCost task="nurse-physician" positive="physician" />
      </section>
    </Fragment>
  )}

  {twoAxes && (
    <section class="wrap section" id="breakdown">
      <h2 class="display">Explore the results by {G} and {I}</h2>
      <p class="lede">The ranking above uses the largest result in this grid. Each square is one {G} on one {I}, measured on its own. Select a {G} to see all its {plural(bd.item_kind)}, a {I} to see every {G}, or a square for the full result.</p>
      <Matrix dim={dim} caption={`${dim.label}: every ${G} by every ${I}`} />
      <nav class="chips" aria-label={`${cap(plural(bd.group_kind))}`}><span class="chips-h">{cap(plural(bd.group_kind))}</span>{bd.groups.map((g) => <a href={urls.at(dim, g.id, null)}>{g.label}</a>)}</nav>
      <nav class="chips" aria-label={`${cap(bd.item_kind)}s`}><span class="chips-h">{cap(bd.item_kind)}s</span>{bd.items.map((i) => <a href={urls.at(dim, null, i.id)}>{i.label}</a>)}</nav>
    </section>
  )}

  {oneAxis && (
    <section class="wrap section" id="breakdown">
      <h2 class="display">Explore each {kindWord}</h2>
      <p class="lede">Each {kindWord} is measured on its own, most biased first. Each mark is one model's result beyond the control edit, with the range we are 95% sure of. A filled mark is a clear effect. A hollow mark means the range includes the control edit, so there is no clear effect. Select a {kindWord} for its page.</p>
      <div data-legend={engines.filter((e) => dim.cells[e.id].status === "measured").map((e) => e.id).join(",")}></div>
      <Chart id="forest" />
    </section>
  )}

  {facets.length < 3 && (
    <section class="wrap section">
      <h2 class="display">How much did the change matter?</h2>
      <p class="lede">Each coloured mark is what the model did after the real edit, with the range we are 95% sure of. The grey band below it is the control edit, with its own range. We call the effect clear only when the model's whole range sits above the control edit's middle value.</p>
      <Chart id="versus" />
    </section>
  )}

  {facets.length >= 3 && (
    <section class="wrap section">
      <h2 class="display">The pattern across {plural(dim.facet_kind)}</h2>
      <p class="lede">One spoke per {F}. The further out a point sits, the more the model moved beyond the control edit on that {F}.{twoAxes ? ` Each point is the largest result across the ${plural(bd.group_kind)}.` : ""} A hollow point is no clear effect. A gap in a shape means we did not test that model there.</p>
      <div data-legend={series.map((s) => s.engine).join(",")}></div>
      <Chart id="spider" cls="chart-box spider-big" />
    </section>
  )}

  {singleCell && singleCell.example && (
    <section class="wrap section">
      <Example example={singleCell.example} note={bd.example_note} />
    </section>
  )}

  <section class="wrap section" id="engines">
    <h2 class="display">Each model's results, {F} by {F}</h2>
    <p class="lede">One table per model. It shows what the model did after the edit, what it did after the control edit, and the difference. Numbers in brackets are the range we are 95% sure of. Each model also has its own page for this characteristic.</p>
    {engines.map((en) => {
      const c = dim.cells[en.id];
      const measured = c.status === "measured";
      return (
        <details id={en.id} class={`cell${measured ? "" : " missing"}`}>
          <summary>
            <EngineName engine={en} />
            {measured
              ? <span class="sum-v">{c.detected ? `${signed(c.headline.value)} percentage points beyond the control edit, on ${c.headline.facet_label}` : "no clear effect"}<span class="sum-n"> · {c.n_facets} {c.n_facets === 1 ? F : plural(dim.facet_kind)} tested</span></span>
              : <span class="sum-v muted">not tested on this characteristic</span>}
          </summary>
          {measured
            ? <Fragment>
                <FacetTable dim={dim} facets={c.facets} headline={c.headline.facet} detected={c.detected} facetKind={dim.facet_kind}
                  caption={`${en.label}, ${dim.label}: results by ${F}`} rowHref={single ? null : (f) => `${facetHref(dim, f.id)}#${en.id}`} sources={false} />
                <p class="more-link"><a href={urls.engineDim(en.id, dim.id)}>{en.label} on {dim.label.toLowerCase()}: its own page</a></p>
              </Fragment>
            : <p class="note">{en.label} has not been tested on this characteristic. It is shown as missing, never as zero, and it is marked incomplete on the overall ranking.</p>}
        </details>
      );
    })}
  </section>

  <HowMeasured dim={dim} facets={allFacets} />
</Base>
