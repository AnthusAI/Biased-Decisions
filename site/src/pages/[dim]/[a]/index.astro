---
// One group (a religion, a nationality, a name group) or one item (a trope question, a task) of a
// dimension: its own board, every row under it ranked, and, where it is a leaf, the full
// measurement per engine and a real example.
import Base from "../../../layouts/Base.astro";
import RegWarn from "../../../components/RegWarn.astro";
import RiskPanel from "../../../components/RiskPanel.astro";
import Shortlist from "../../../components/Shortlist.astro";
import Board from "../../../components/Board.astro";
import Chart from "../../../components/Chart.astro";
import Chip from "../../../components/Chip.astro";
import EngineName from "../../../components/EngineName.astro";
import FacetTable from "../../../components/FacetTable.astro";
import Example from "../../../components/Example.astro";
import HowMeasured from "../../../components/HowMeasured.astro";
import ModelsLine from "../../../components/ModelsLine.astro";
import { kindName, kindNames } from "../../../scripts/util.js";
import { shortlistBlock } from "../../../lib/compliance.js";
import { engines, urls, levelPages, levelPayload, levelTitle, levelPath, describeLevel, cellsUnder, rowKind, rowLabel,
  forestRows, groupOf, itemOf, multiGroup, cellSentence, unit, fmt, signed, cap, isNonHiring } from "../../../lib/site.js";

export function getStaticPaths() {
  return levelPages().filter(({ level }) => level.kind !== "cell")
    .map(({ dim, level }) => ({ params: { dim: dim.id, a: level.group || level.item }, props: { dim, level } }));
}
const { dim, level } = Astro.props;
const bd = dim.breakdown;
const title = levelTitle(dim, level);
const path = levelPath(dim, level);
const under = cellsUnder(dim, level);
const leaf = under.length === 1;
const cell = leaf ? under[0] : null;
const kind = kindName(rowKind(dim, level));
const plural = (k) => kindNames(k);
const payload = { ...levelPayload(dim, level), measure_plain: dim.measure_plain, raw_unit: dim.raw_unit };
const charts = { board: { type: "board", dim: payload } };
if (!leaf) {
  charts.forest = { type: "forest", rows: forestRows(dim, under, (c) => rowLabel(dim, level, c), (c) => urls.at(dim, c.group, c.item)),
    label: `${dim.long}, ${title}: every ${kind}, every model`, axisLabel: "beyond the control edit, percentage points" };
} else {
  charts.versus = { type: "versus", dim: payload };
}
const group = level.group ? groupOf(dim, level.group) : null;
const item = level.item ? itemOf(dim, level.item) : null;
const isMixed = dim.facet_kind === "test";
const isTrope = dim.facet_kind === "question" || (!!item && !!item.trope);
const measuredEngines = engines.filter((e) => under.some((c) => c.engines[e.id].status === "measured"));
const siblings = level.kind === "group"
  ? bd.groups.filter((g) => g.id !== level.group).map((g) => ({ label: g.label, href: urls.at(dim, g.id, null) }))
  : bd.items.filter((i) => i.id !== level.item).map((i) => ({ label: i.label, href: urls.at(dim, null, i.id) }));
const siblingKind = kindName(level.kind === "group" ? (bd.group_kind || "group") : bd.item_kind);
const kicker = `${dim.long} · ${siblingKind}`;
const leafFacets = leaf ? engines.map((e) => ({ ...cell.engines[e.id], label: e.label, _engine: e.id })) : [];
const floorClause = group && isTrope ? (under.map((c) => Object.values(c.engines).find((f) => f.extra && f.extra.floor_clause)).find(Boolean)?.extra.floor_clause || "").trim() : "";
// "a Asian ..." in a clause reads as "an Asian ...".
const article = (t) => t.replace(/^a (?=[AEIOU])/, "an ");
const allFacets = under.flatMap((c) => Object.values(c.engines));
const shortlistFiles = dim.id === "gender" && item && shortlistBlock(item.id) ? [shortlistBlock(item.id).study] : [];
---
<Base title={`${title} · ${dim.long}`} description={describeLevel(dim, level)} path={path} current={{ page: "level", dim: dim.id }} charts={charts}
  crumbs={[{ label: "Leaderboard", href: urls.home() }, { label: dim.long, href: urls.dim(dim.id) }, { label: title }]}>
  <section class="wrap hero dim-hero">
    <p class="kicker">{kicker}</p>
    <h1 class="display xl">{title}</h1>
    {!isNonHiring(level) && <RegWarn dim={dim} />}
    {group && isMixed && (
      <p class="deck">How far each model's answers moved when a short professional biography opened with <q>{group.clause.trim()}</q>, test by test. Some tests are job decisions; others are questions that test a stereotype.</p>
    )}
    {group && isTrope && !isMixed && (
      <p class="deck">How far each model's answers moved when a short professional biography opened with <q>{group.clause.trim()}</q> instead of the control edit <q>{floorClause}</q>, question by question. The stereotype score is how far this {kindName(bd.group_kind)} moved the model's confidence, minus the average move for the other {plural(bd.group_kind)}, in percentage points. Zero means no stereotype.</p>
    )}
    {group && !isTrope && !isMixed && (
      <p class="deck">{dim.id === "race"
        ? (/in place of/.test(group.clause)
          ? <Fragment>We gave each short professional biography {group.clause.trim()}, and counted how often each model changed its answer.</Fragment>
          : <Fragment>Every result for the {group.label} group, decision by decision. In short professional biographies we used {article(group.clause.trim())} in place of a white one. Each other decision has its own control edit, shown with its result.</Fragment>)
        : <Fragment>We added <q>{group.clause.trim()}</q> to each text, compared it with a control edit, and measured how far each model's answer moved.</Fragment>}</p>
    )}
    {item && isTrope && (
      <Fragment>
        <p class="deck"><q>{item.question}</q></p>
        <dl class="defs">
          <div><dt>The stereotype it tests</dt><dd>{item.trope}</dd></div>
          <div><dt>The answer that fits the stereotype</dt><dd>{item.trope_consistent_answer}</dd></div>
        </dl>
      </Fragment>
    )}
    {item && !isTrope && (
      <Fragment>
        <p class="deck">The decision: <q>{item.question}</q>{multiGroup(dim) ? ` Every ${kindName(bd.group_kind)}, ranked on this decision.` : ""}</p>
        <dl class="defs">
          <div><dt>What we changed</dt><dd>{dim.cue}</dd></div>
          <div><dt>The control edit</dt><dd>A harmless change of the same size, or simply asking again, that shows how much the model moves for no good reason. Here: {dim.floor}</dd></div>
          {item.note && <div><dt>About this decision</dt><dd>{cap(item.note)}.</dd></div>}
        </dl>
      </Fragment>
    )}
    {!(item && !isTrope) && <p class="note">The control edit is a harmless change of the same size. It shows how much the model moves for no good reason, so a result only counts beyond it.</p>}
    <ModelsLine />
    {dim.source === "batch2-staging" && <div class="footnote" role="note"><p>Only Laya has answered these questions so far. We scored its answers separately, and our tools cannot yet re-run these numbers from the saved answers.</p></div>}
  </section>

  <Board board={level.board} heads={level.heads} unit={unit(dim)} facetKind={leaf ? null : kind} chartId="board"
    hrefFor={(e) => `${path}#${e}`} heading={leaf ? "The ranking: most biased model first" : `The ranking for ${title}`}
    lede={leaf ? null : `Most biased first. Each model is placed by its largest result beyond the control edit among ${title}'s ${plural(kind)}, the same rule as every ranking on this site. Thin ticks mark its other ${plural(kind)}. Select a row for that model's numbers below.`} />

  {!isNonHiring(level) && <RiskPanel dim={dim} level={level} place={title} />}

  {!leaf && (
    <section class="wrap section" id="rows">
      <h2 class="display">Every {kind}, ranked</h2>
      <p class="lede">Most biased first. Each row is one {kind}. Each mark is one model's result beyond the control edit, with the range we are 95% sure of. Filled: a clear effect. Hollow with a dashed line: the range includes the control edit, so no clear effect. Hollow with a solid line below zero: a clear effect in the opposite direction. Select a row for its full result.</p>
      <div data-legend={measuredEngines.map((e) => e.id).join(",")}></div>
      <Chart id="forest" />
      <div class="table-scroll" tabindex="0" role="region" aria-label={`${title}: every ${kind}`}>
        <table class="cell-table rows-table">
          <thead><tr><th scope="col">{cap(kind)}</th>{measuredEngines.map((e) => <th scope="col"><EngineName engine={e} size={10} /> beyond the control edit [range]</th>)}</tr></thead>
          <tbody>
            {under.map((c) => (
              <tr>
                <th scope="row"><a href={urls.at(dim, c.group, c.item)}>{rowLabel(dim, level, c)}</a>
                  {isTrope && level.kind === "group" && <div class="sub">{itemOf(dim, c.item).question}</div>}</th>
                {measuredEngines.map((e) => {
                  const f = c.engines[e.id];
                  return f.status === "measured"
                    ? <td class="num" id={level.kind === "group" ? undefined : undefined}><strong>{signed(f.excess.value)}</strong><span class="ci-t"> [{fmt(f.excess.lo)}, {fmt(f.excess.hi)}]</span> <Chip facet={f} /></td>
                    : <td class="muted">not tested</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {!leaf && (
    <section class="wrap section" id="engines">
      <h2 class="display sm">Each model</h2>
      {engines.map((e) => {
        const h = level.heads[e.id];
        return (
          <div class="eng-line" id={e.id}>
            <EngineName engine={e} href={urls.engineDim(e.id, dim.id)} />
            <span>{h.status !== "measured" ? "not tested here" : h.detected ? `${signed(h.headline.value)} percentage points beyond a control edit of ${fmt(h.headline.floor_value)}${unit(dim).trim() === "pts" ? " points" : unit(dim)} at its largest, on ${h.headline.facet_label}. ${h.n_facets_detected} of ${h.n_facets} ${plural(kind)} show a clear effect.` : `No clear effect on any of its ${h.n_facets} ${plural(kind)}, in ${h.n.toLocaleString("en-US")} texts.`}</span>
          </div>
        );
      })}
    </section>
  )}

  {leaf && (
    <section class="wrap section" id="measurements">
      <h2 class="display">Every model's result</h2>
      {measuredEngines.map((e) => <p class="lede plain">{cellSentence(dim, cell, e.id)}</p>)}
      <p class="note">Numbers in brackets are the range we are 95% sure of.</p>
      <FacetTable dim={dim} facets={leafFacets} facetKind="engine" caption={`${dim.long}, ${title}: every model`}
        rowId={(f) => f._engine} rowHref={(f) => urls.engineDim(f._engine, dim.id)} sources={false} />
      <h3>The real edit against the control edit</h3>
      <p class="note">Each coloured mark is what the model did after the real edit, with its range. The grey band below it is the control edit, with its own range.</p>
      <Chart id="versus" />
    </section>
  )}

  {leaf && cell.example && (
    <section class="wrap section"><Example example={cell.example} note={bd.example_note} /></section>
  )}

  {dim.id === "gender" && item && <Shortlist task={item.id} positive={item.positive} />}

  <section class="wrap section">
    <nav class="chips" aria-label={`Other ${plural(siblingKind)}`}>
      <span class="chips-h">Other {plural(siblingKind)}</span>
      {siblings.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>
    <p class="more-link"><a href={urls.dim(dim.id)}>Back to every result for {dim.label.toLowerCase()}</a></p>
  </section>

  <HowMeasured dim={dim} facets={allFacets} extra={shortlistFiles} />
</Base>
