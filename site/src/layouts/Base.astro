---
// The body of every page, as an HTML fragment: the "what we tested" rail, the breadcrumbs, the page, the
// honesty panel, the clients panel, the colophon and the page's chart payload. The standard Papyrus front
// end (site/web/) wraps it with the head, header and footer. The JSON block this layout puts first carries
// the page's metadata; scripts/stage-pages.mjs reads it and hands it to Papyrus as a custom page.
import { data, engines, dimensions, urls, SITE_NAME } from "../lib/site.js";
import { cardFor } from "../lib/cards.js";
import { curls } from "../lib/compliance.js";

const { title, description, path, current = {}, charts = null, crumbs = [], noindex = false } = Astro.props;
const card = noindex ? null : cardFor(path);
if (!noindex && !card) throw new Error(`no social card for ${path}`);
const p = data.provenance;
const rel = p.release;
const REPO = "https://github.com/AnthusAI/Biased-Decisions";
// The caveats panel: four or six cards (never five: the grid would leave an orphan), open on the
// home page and folded to one line everywhere else.
const caveatCount = { 4: "Four", 6: "Six" }[data.honesty.length];
if (!caveatCount) throw new Error(`the caveats panel needs four or six cards, not ${data.honesty.length}`);
const caveatLinks = { data: urls.data() };
const meta = {
  path,
  title: title || SITE_NAME,
  description: card?.description || description,
  noindex,
  card: card ? { headline: card.headline, alt: card.alt, url: card.url } : null,
};
const payload = charts ? JSON.stringify({ engines: engines.map(({ id, label, marker }) => ({ id, label, marker })), charts }).replace(/</g, "\\u003c") : null;
---
<script type="application/json" id="page-meta" set:html={JSON.stringify(meta).replace(/</g, "\\u003c")}></script>
<div class="wrap">
  <nav class="rail" aria-label="What we tested">
    {dimensions.map((d) => (
      <a href={urls.dim(d.id)} class={current.dim === d.id ? "on" : null} aria-current={current.dim === d.id && current.page === "dimension" ? "page" : undefined}>{d.label}</a>
    ))}
    <span class="rail-sep" aria-hidden="true"></span>
    <a href={`${urls.home()}antisemitism-and-israel/`} class={current.page === "antisemitism-israel" ? "on" : null} aria-current={current.page === "antisemitism-israel" ? "page" : undefined}>Jewish &amp; Israel</a>
    <a href={`${urls.home()}stereotypes/`} class={current.page === "stereotypes" ? "on" : null} aria-current={current.page === "stereotypes" ? "page" : undefined}>Stereotypes</a>
  </nav>
</div>
{crumbs.length > 0 && (
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c, i) => (
        <li>{i < crumbs.length - 1 || c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
      ))}
    </ol>
  </nav>
)}
<slot />
<aside class="wrap honesty" aria-labelledby="honesty-h">
  <details id="read-first" open={current.page === "overview"}>
    <summary><h2 id="honesty-h" class="display sm">{caveatCount} things to know before you read the results</h2></summary>
    <ol data-count={data.honesty.length}>
      {data.honesty.map((x) => <li class="caveat"><strong>{x.title}</strong><span>{x.text}{x.link && <Fragment> <a href={caveatLinks[x.link.to]}>{x.link.label}</a>.</Fragment>}</span></li>)}
    </ol>
  </details>
</aside>
<aside class="wrap clients" aria-labelledby="clients-h">
  <h2 id="clients-h" class="display sm">We do this for clients</h2>
  <p>Anthus built this leaderboard to decide which decisions to trust to a model, and how to shape a decision so a personal detail cannot move the answer. Six of the nine characteristics here are protected under hiring rules.</p>
  <p>We bring that judgment to client work. We shape the decision, pick the model the numbers support, build it into your product as a cyclotron, an AI decision that learns from your reviewers' corrections, and run it with your reviewers in the loop.</p>
  <p class="clients-links"><a href="https://cyclotron.anth.us/services">How we build and run decisions</a> <a href="https://anth.us/engage/">How an engagement works</a> <a href="https://cyclotron.anth.us/">Cyclotron is open source</a></p>
</aside>
<div class="colophon">
  <div class="wrap colo">
    <p class="release" data-release={rel.label}>{rel.released
      ? <Fragment>Release <a href={rel.url}><strong>v{rel.version}</strong></a>, published <time datetime={rel.date}>{rel.date}</time>.</Fragment>
      : <Fragment>Version <strong>v{rel.version}</strong>, <strong>unreleased</strong>.</Fragment>}</p>
    <p>Every number on this site is worked out from the models' saved answers{p.generated ? <Fragment>, on <strong>{p.generated}</strong></Fragment> : ""}, at version {p.record_commit ? <a href={`${REPO}/commit/${p.record_commit}`}><code>{p.record_commit_short}</code></a> : <code>unknown</code>} of the public repository, with <code>{p.command}</code>. You can download <a href={urls.data()}>every number in one data file</a>. <a href={`${urls.home()}about/`}>About this site</a>.</p>
    <p>Where the answers come from: {p.sources.map((src, i) => <Fragment>{i ? "; " : ""}<code>{src.path}</code> ({src.regenerated_by ? <Fragment>re-run from the saved answers with <code>{src.regenerated_by}</code></Fragment> : "from a separate run whose saved answers are not public yet"})</Fragment>)}.</p>
    <p class="fine">Biased-Decisions is MIT-licensed (<a href={REPO}>source</a>). Bias in Bios (De-Arteaga et al., 2019) is MIT-licensed on the Hugging Face Hub. Typefaces: Jersey 25 and Montserrat, SIL Open Font License.</p>
  </div>
</div>
{payload && <script type="application/json" id="bd-charts" set:html={payload}></script>}
{payload && <div class="papyrus-island" data-island="Charts" data-props="{}"></div>}
