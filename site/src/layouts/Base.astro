---
// Every page: head metadata (canonical URL, description, Open Graph), the masthead, the honesty
// panel, the colophon, and the page's chart payload. The page body is static HTML.
import "../styles/site.css";
import scales from "../assets/scales.svg?raw";
import { data, engines, dimensions, urls, absolute, SITE_NAME } from "../lib/site.js";
import { cardFor } from "../lib/cards.js";
import { curls } from "../lib/compliance.js";

const { title, description, path, current = {}, charts = null, crumbs = [], noindex = false } = Astro.props;
const site = Astro.site;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = absolute(path, site);
const card = noindex ? null : cardFor(path);
if (!noindex && !card) throw new Error(`no social card for ${path}`);
const ogImage = card ? absolute(card.url, site) : null;
const p = data.provenance;
const rel = p.release;
const REPO = "https://github.com/AnthusAI/Biased-Decisions";
// The caveats panel: four or six cards (never five: the grid would leave an orphan), open on the
// home page and folded to one line everywhere else.
const caveatCount = { 4: "Four", 6: "Six" }[data.honesty.length];
if (!caveatCount) throw new Error(`the caveats panel needs four or six cards, not ${data.honesty.length}`);
const caveatLinks = { data: urls.data() };
const light = engines.map((e) => `--eng-${e.id}: ${e.color};`).join(" ");
const dark = engines.map((e) => `--eng-${e.id}: ${e.color_dark || e.color};`).join(" ");
const engineCss = `:root { ${light} }
@media (prefers-color-scheme: dark) { :root { ${dark} } }
@media print { :root { ${light} } }`;
const payload = charts ? JSON.stringify({ engines: engines.map(({ id, label, marker }) => ({ id, label, marker })), charts }).replace(/</g, "\\u003c") : null;
// Google Analytics 4, the same property as anth.us (hostname splits the reports). Production builds only.
const GA_ID = "G-31SC26SDGX";
const gtagInit = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_ID}');`;
// Opt-out: visit any page with ?notrack=1 to set a localStorage flag that disables GA in this browser (?notrack=0 clears it).
// ga-disable-<ID> must be set before gtag('config'). String.raw keeps \w intact.
const optOut = String.raw`(function(){try{var k='anthus-no-analytics',q=location.search.match(/[?&]notrack=(\w+)/);if(q){if(q[1]==='1')localStorage.setItem(k,'1');else localStorage.removeItem(k)}if(localStorage.getItem(k)==='1')window['ga-disable-G-31SC26SDGX']=true}catch(e){}})();`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={card?.description || description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:title" content={card ? card.headline : (title || SITE_NAME)}>
<meta property="og:description" content={card?.description || description}>
<meta property="og:url" content={canonical}>
{card && <Fragment>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={card.alt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={card.headline}>
<meta name="twitter:description" content={card?.description || description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={card.alt}>
</Fragment>}
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f1f9fe" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0f1a22" media="(prefers-color-scheme: dark)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jersey+25&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
<link rel="icon" href={`${urls.home()}favicon.ico`} sizes="16x16 32x32">
<link rel="icon" type="image/png" sizes="32x32" href={`${urls.home()}favicon-32.png`}>
<link rel="icon" type="image/svg+xml" sizes="any" href={`${urls.home()}favicon.svg`}>
<link rel="apple-touch-icon" sizes="180x180" href={`${urls.home()}apple-touch-icon.png`}>
<link rel="alternate" type="application/json" href={urls.data()} title="The leaderboard data file">
<style is:inline set:html={engineCss}></style>
{import.meta.env.PROD && <Fragment>
<script is:inline set:html={optOut}></script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline set:html={gtagInit}></script>
</Fragment>}
</head>
<body>
<a class="skip" href="#app">Skip to content</a>
<header class="masthead">
  <div class="mast-inner">
    <div class="wrap mast-row">
      <a href={urls.home()} class="brand" aria-label="Biased Decisions">
        <span><span class="brand-a">Biased</span><span class="brand-b">Decisions</span></span>
        <span class="brand-icon" aria-hidden="true" set:html={scales}></span>
      </a>
      <nav class="topnav" aria-label="Site">
        <a href={urls.methods()} class={current.page === "methods" ? "on" : null} aria-current={current.page === "methods" ? "page" : undefined}>How we measure</a>
        <a href={curls.howToFail()} class={current.page === "how-to-fail" ? "on" : null} aria-current={current.page === "how-to-fail" ? "page" : undefined}>How to fail</a>
        <a href={curls.guidance()} class={current.page === "guidance" ? "on" : null} aria-current={current.page === "guidance" ? "page" : undefined}>Guidance</a>
      </nav>
    </div>
    <div class="wrap">
      <nav class="rail" aria-label="Characteristics we tested">
        {dimensions.map((d) => (
          <a href={urls.dim(d.id)} class={current.dim === d.id ? "on" : null} aria-current={current.dim === d.id && current.page === "dimension" ? "page" : undefined}>{d.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>
<main id="app">
  {crumbs.length > 0 && (
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>{i < crumbs.length - 1 || c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
  )}
  <slot />
  <aside class="wrap honesty" aria-labelledby="honesty-h">
    <details id="read-first" open={current.page === "overview"}>
      <summary><h2 id="honesty-h" class="display sm">{caveatCount} things to know before you read the results</h2></summary>
      <ol data-count={data.honesty.length}>
        {data.honesty.map((x) => <li class="caveat"><strong>{x.title}</strong><span>{x.text}{x.link && <Fragment> <a href={caveatLinks[x.link.to]}>{x.link.label}</a>.</Fragment>}</span></li>)}
      </ol>
    </details>
  </aside>
</main>
<footer class="colophon">
  <div class="wrap colo">
    <p class="release" data-release={rel.label}>{rel.released
      ? <Fragment>Release <a href={rel.url}><strong>v{rel.version}</strong></a>, published <time datetime={rel.date}>{rel.date}</time>.</Fragment>
      : <Fragment>Version <strong>v{rel.version}</strong>, <strong>unreleased</strong>.</Fragment>}</p>
    <p>Every number on this site is worked out from the models' saved answers{p.generated ? <Fragment>, on <strong>{p.generated}</strong></Fragment> : ""}, at version {p.record_commit ? <a href={`${REPO}/commit/${p.record_commit}`}><code>{p.record_commit_short}</code></a> : <code>unknown</code>} of the public repository, with <code>{p.command}</code>. You can download <a href={urls.data()}>every number in one data file</a>.</p>
    <p>Where the answers come from: {p.sources.map((src, i) => <Fragment>{i ? "; " : ""}<code>{src.path}</code> ({src.regenerated_by ? <Fragment>re-run from the saved answers with <code>{src.regenerated_by}</code></Fragment> : "from a separate run whose saved answers are not public yet"})</Fragment>)}.</p>
    <p class="fine">Biased-Decisions is MIT-licensed (<a href={REPO}>source</a>). Bias in Bios (De-Arteaga et al., 2019) is MIT-licensed on the Hugging Face Hub. Typefaces: Jersey 25 and Montserrat, SIL Open Font License.</p>
  </div>
</footer>
{payload && <script type="application/json" id="bd-charts" set:html={payload}></script>}
<script src="../scripts/client.js"></script>
</body>
</html>
