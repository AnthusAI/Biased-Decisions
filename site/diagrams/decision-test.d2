# The decision-test pipeline: one detail changed in a real decision, measured against a control edit.
# Palette matches site/src/styles/site.css: bg #f1f9fe, ink #0c1e2b, rule #cfdfea, alarm #c8102e.
vars: {
  d2-config: {
    theme-id: 0
  }
}
direction: right

bio: {
  label: "A real biography\n\"He joined the firm in 2014...\""
  shape: rectangle
  style: { fill: "#ffffff"; stroke: "#cfdfea"; font-color: "#0c1e2b"; stroke-width: 2 }
}

edit: {
  label: "One word changed\n\"He\" -> \"She\""
  shape: rectangle
  style: { fill: "#e6f2fa"; stroke: "#0389d7"; font-color: "#0c1e2b"; stroke-width: 2 }
}

control: {
  label: "Control edit\n\"He\" -> \"He\" (asked again)"
  shape: rectangle
  style: { fill: "#e6f2fa"; stroke: "#8a949c"; font-color: "#0c1e2b"; stroke-width: 2; stroke-dash: 4 }
}

model: {
  label: "Decision model\n\"Paralegal or attorney?\""
  shape: rectangle
  style: { fill: "#0c1e2b"; font-color: "#ffffff"; stroke: "#0c1e2b" }
}

compare: {
  label: "Compare the two answers"
  shape: diamond
  style: { fill: "#ffffff"; stroke: "#cfdfea"; font-color: "#0c1e2b" }
}

result: {
  label: "The effect beyond\nthe control edit"
  shape: rectangle
  style: { fill: "#fdecef"; stroke: "#c8102e"; font-color: "#b3122e"; stroke-width: 2 }
}

bio -> edit
bio -> control: { style: { stroke-dash: 4 } }
edit -> model
control -> model: { style: { stroke-dash: 4 } }
model -> compare
compare -> result
